# Backend target used by the Vite dev/preview proxy for /api, /uploads and /socket.io
VITE_PROXY_TARGET=http://localhost:4000

# Axios base URL. Default "/api" (goes through the proxy). Set a full URL to bypass the proxy,
# e.g. http://localhost:4000/api
VITE_API_URL=/api

# Socket.IO origin. Default: window.location.origin (goes through the proxy).
# e.g. http://localhost:4000
VITE_SOCKET_URL=
