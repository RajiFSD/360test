# --- Server ---
NODE_ENV=development
PORT=4000
# Comma-separated list of allowed browser origins (web app). Mobile apps don't send Origin.
CORS_ORIGINS=http://localhost:5173
# Public origin used to build absolute upload URLs
PUBLIC_URL=http://localhost:4000

# --- MariaDB ---
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=smartoutpass
DB_PASSWORD=change-me
DB_NAME=smartoutpass
DB_POOL_SIZE=10

# --- Auth (generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))") ---
JWT_ACCESS_SECRET=replace-with-64-random-hex-chars
JWT_ACCESS_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30
# Separate key for signing outpass QR codes
QR_SIGNING_SECRET=replace-with-another-64-random-hex-chars
BCRYPT_ROUNDS=10

# --- Jobs ---
# Set to false to disable node-cron jobs (e.g. when running several API instances, enable on one only)
ENABLE_JOBS=true

# --- Notifications ---
# Expo push is used automatically for users that registered a push token
EXPO_ACCESS_TOKEN=
# SMS provider: console | twilio | none
SMS_PROVIDER=console
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# --- AI ---
# node = built-in logistic regression (models/delay-model.json); http = external service (e.g. Python) at AI_SERVICE_URL
AI_PROVIDER=node
AI_SERVICE_URL=http://localhost:8000
AI_MODEL_PATH=./models/delay-model.json
